{
  "title": {
    "en": "Request seat heating or ventilation",
    "sv": "Begär sätesvärme eller ventilation"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=zeekr"
    },
    {
      "name": "seat",
      "type": "dropdown",
      "title": {
        "en": "Seat",
        "sv": "Säte"
      },
      "values": [
        {
          "id": "driver",
          "label": {
            "en": "Driver",
            "sv": "Förare"
          }
        },
        {
          "id": "passenger",
          "label": {
            "en": "Passenger",
            "sv": "Passagerare"
          }
        },
        {
          "id": "rear_left",
          "label": {
            "en": "Rear left",
            "sv": "Bak vänster"
          }
        },
        {
          "id": "rear_right",
          "label": {
            "en": "Rear right",
            "sv": "Bak höger"
          }
        }
      ]
    },
    {
      "name": "mode",
      "type": "dropdown",
      "title": {
        "en": "Mode",
        "sv": "Läge"
      },
      "values": [
        {
          "id": "heat",
          "label": {
            "en": "Heating",
            "sv": "Värme"
          }
        },
        {
          "id": "vent",
          "label": {
            "en": "Ventilation (front only)",
            "sv": "Ventilation (endast fram)"
          }
        }
      ]
    },
    {
      "name": "level",
      "type": "number",
      "title": {
        "en": "Level (0 = off)",
        "sv": "Nivå (0 = av)"
      },
      "min": 0,
      "max": 3,
      "step": 1
    },
    {
      "name": "minutes",
      "type": "number",
      "title": {
        "en": "Minutes",
        "sv": "Minuter"
      },
      "min": 1,
      "max": 60,
      "step": 1
    }
  ],
  "hint": {
    "en": "Requests a cloud command from Zeekr. Model, region, account and vehicle state determine support. Only vehicle telemetry confirms the result.",
    "sv": "Begär ett molnkommando från Zeekr. Stöd beror på modell, region, konto och bilstatus. Endast bilens telemetri bekräftar resultatet."
  },
  "titleFormatted": {
    "en": "Request seat heating or ventilation [[seat]], [[mode]], [[level]], [[minutes]]",
    "sv": "Begär sätesvärme eller ventilation [[seat]], [[mode]], [[level]], [[minutes]]"
  }
}
