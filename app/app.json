        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zeekr"
          }
        ],
        "id": "is_charging"
      },
      {
        "title": {
          "en": "The car !{{is|is not}} locked",
          "sv": "Bilen !{{är|är inte}} låst"
