  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Battery level changed",
          "sv": "Batterinivån ändrades"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zeekr"
          }
        ],
        "tokens": [
          {
            "name": "level",
            "type": "number",
            "title": {
              "en": "Battery level (%)",
              "sv": "Batterinivå (%)"
            }
          }
        ],
        "id": "battery_changed"
      },
      {
        "title": {
          "en": "Charging status changed",
          "sv": "Laddstatus ändrades"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zeekr"
          }
        ],
        "tokens": [
          {
            "name": "active",
            "type": "boolean",
            "title": {
              "en": "Active",
              "sv": "Aktiv"
            }
          }
        ],
        "id": "charging_changed"
      },
